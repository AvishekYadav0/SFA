PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
NODE_ENV=production
# Server-enforced minimum visit duration; shorter visits require authorized review.
VISIT_MIN_DURATION_MINUTES=60
# Unstarted daily stops are marked Missed at this UTC hour.
VISIT_PLAN_DEADLINE_HOUR=23
# Active check-ins older than this are highlighted for review.
VISIT_MAX_ACTIVE_HOURS=12
# Global approved-shop GPS geofence radius; overrides each shop's configured radius.
VISIT_GEOFENCE_RADIUS_METERS=3999
# Check-in/check-out location changes beyond this distance are flagged Suspicious.
VISIT_MAX_LOCATION_CHANGE_METERS=3999

# Daily database backups (the cron schedui le uses server time unless BACKUP_TIMEZONE is set).
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# BACKUP_TIMEZONE=Asia/Kathmandu
BACKUP_RETENTION_DAYS=30
# Use a private persistent mount in production; relative paths resolve from the backend directory.
BACKUP_DIRECTORY=./secure-backups
