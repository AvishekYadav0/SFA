PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
NODE_ENV=production

# Daily database backups (the cron schedule uses server time unless BACKUP_TIMEZONE is set).
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# BACKUP_TIMEZONE=Asia/Kathmandu
BACKUP_RETENTION_DAYS=30
# Use a private persistent mount in production; relative paths resolve from the backend directory.
BACKUP_DIRECTORY=./secure-backups
